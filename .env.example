# Deployer key, 0x-prefixed. Never commit the real one; this file is the template.
# The account needs testnet ETH on whichever network you deploy to.
DEPLOYER_PRIVATE_KEY=

# --- Sepolia (`pnpm deploy:sepolia`) ---
# Optional. Defaults to a public node, which is fine for a testnet deploy but rate limited;
# an Alchemy or Infura URL is steadier for a run this size.
SEPOLIA_RPC_URL=
# For `pnpm verify:sepolia`. Free from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# --- Robinhood Chain (`pnpm deploy:testnet` / `pnpm deploy:mainnet`) ---
ROBINHOOD_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=
